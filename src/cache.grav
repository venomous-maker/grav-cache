// cache.grav — Cache: get/put/remember a value under a key, on whichever
// store backs it (memory, a file, Redis, or a database table through
// grav-orbit), plus locks (Cache.lock) and rate limiting (Cache.limiter) on
// top of any store.
//
//   Cache.store(new FileCacheStore("/tmp/cache"))
//   Cache.put("greeting", "hello", 60)             // expires in 60 seconds
//   Cache.get("greeting")                          // "hello"
//   Cache.remember("user:1", 300, fn() -> any { return loadUser(1) })
//
// A value is kept as JSON text: null, bool, a whole or fractional number, a
// string, DateTime, Decimal, and Array/HashMap of those — the same values
// `str(v)`/reflection already turn into JSON elsewhere. Anything else, keep
// as a map yourself first (`u.toMap()` on an Orbit model, say).
import "std"

namespace cache {

    // What a cache store does with already-encoded text (see the top of this
    // file for what Cache itself adds on top: JSON, remember(), ...).
    interface CacheStore {
        // The raw text under `key`, or null when it is missing or expired.
        fn get(key: string) -> string?
        // Stores it; `ttlSeconds` 0 keeps it until forget()/flush() (forever()).
        fn put(key: string, value: string, ttlSeconds: long)
        fn forever(key: string, value: string) { self.put(key, value, 0) }
        // Whether `get(key)` would give something.
        fn has(key: string) -> bool { return self.get(key) != null; }
        // Removes it; whether there was one.
        fn forget(key: string) -> bool
        // Adds `by` to the number at `key` (0 first), atomically where the
        // store can; a store that cannot throws StateError.
        fn increment(key: string, by: long) -> long
        // Removes every key this store manages.
        fn flush()
        // The raw text under each of `keys`, in order (null for a missing or
        // expired one). A store that can fetch several in one go overrides it.
        fn getMany(keys: Array<string>) -> Array<string?> {
            let out = new Array<string?>();
            for (k in keys) { out.push(self.get(k)); }
            return out;
        }
        // Stores every one of `values`; a store that can write several in one
        // go overrides it.
        fn putMany(values: HashMap<string, string>, ttlSeconds: long) {
            for ((k, x) in values) { self.put(k, x, ttlSeconds); }
        }
        // Stores it only when the key is missing; whether it did. Atomic where
        // the store can be (Redis: SET NX; memory: under its lock); this default
        // checks and then writes, which can race between processes.
        fn add(key: string, value: string, ttlSeconds: long) -> bool {
            if (self.has(key)) { return false; }
            self.put(key, value, ttlSeconds);
            return true;
        }
        // Removes the key only while it still holds `value` (releasing a lock
        // only its owner holds); whether it did. Atomic on Redis and in memory.
        fn forgetIfValue(key: string, value: string) -> bool {
            let v = self.get(key);
            return v != null && v == value && self.forget(key);
        }
        // Seconds until the key expires: 0 for never, -1 when it is missing.
        fn ttl(key: string) -> long { return self.has(key) ? 0 : -1; }
    }

    // Turns a value into the JSON text a store keeps, and back. The plain
    // values any store round-trips: null, bool, numbers, strings, DateTime,
    // Decimal, and Array<any>/HashMap<string, any> of those.
    class CacheValue {
        static fn encode(v: any) -> string { return CacheValue.toJson(v).toJson(); }
        static fn decode(text: string) -> any { return CacheValue.fromJson(Json.parse(text)); }
        private static fn toJson(v: any) -> JsonValue {
            if (v == null) { return Json.nil(); }
            if (v is bool) { return Json.of(v as bool); }
            if (v is long) { return Json.of(v as long); }
            if (v is int) { return Json.of((v as int) as long); }
            if (v is float) { return Json.of(v as float); }
            if (v is double) { return Json.of(v as double); }
            if (v is string) { return Json.of(v as string); }
            if (v is DateTime) { return Json.of((v as DateTime).toString()); }
            if (v is Decimal) { return Json.of((v as Decimal).toString()); }
            if (v is JsonValue) { return v as JsonValue; }
            if (v is HashMap<string, any>) {
                let o = Json.object();
                let m = v as HashMap<string, any>;
                for ((k, x) in m) { o.set(k, CacheValue.toJson(x)); }
                return o;
            }
            if (v is Array<any>) {
                let a = Json.array();
                for (x in v as Array<any>) { a.push(CacheValue.toJson(x)); }
                return a;
            }
            throw new ValueError("cache values are JSON-plain (null, bool, numbers, strings, DateTime, " +
                                 "Decimal, Array/HashMap of those): got " + typename(v));
        }
        private static fn fromJson(j: JsonValue) -> any {
            if (j == null || j.isNull()) { return null; }
            if (j.isBool()) { return j.asBool(); }
            if (j.isInteger()) { return j.asLong(); }
            if (j.isNumber()) { return j.asFloat(); }
            if (j.isString()) { return j.asString(); }
            if (j.isArray()) {
                let out = new Array<any>();
                for (x in j.asArray()) { out.push(CacheValue.fromJson(x)); }
                return out;
            }
            let out = new HashMap<string, any>();
            for (k in j.keys()) { out.put(k, CacheValue.fromJson(j.get(k))); }
            return out;
        }
    }

    // A store, with the typed get/put/remember layer on top (see the top of
    // this file). `Cache`'s static methods forward to one of these (the
    // default, or a named one).
    class CacheRepository {
        public store: CacheStore
        constructor(store: CacheStore) { self.store = store; }

        fn get(key: string, fallback: any = null) -> any {
            let raw = self.store.get(key);
            return raw == null ? fallback : CacheValue.decode(raw);
        }
        fn put(key: string, value: any, ttlSeconds: long = 0) { self.store.put(key, CacheValue.encode(value), ttlSeconds); }
        fn forever(key: string, value: any) { self.store.forever(key, CacheValue.encode(value)); }
        fn has(key: string) -> bool { return self.store.has(key); }
        // Removes it, whether there was one.
        fn forget(key: string) -> bool { return self.store.forget(key); }
        // Reads it, then removes it.
        fn pull(key: string, fallback: any = null) -> any {
            let v = self.get(key, fallback);
            self.forget(key);
            return v;
        }
        // What is there already, or `f()`'s result, put under `ttlSeconds` and given back.
        // (One read of the store either way: a hit is decoded from it.)
        fn remember(key: string, ttlSeconds: long, f: fn() -> any) -> any {
            let raw = self.store.get(key);
            if (raw != null) { return CacheValue.decode(raw); }
            let v = f();
            self.put(key, v, ttlSeconds);
            return v;
        }
        fn rememberForever(key: string, f: fn() -> any) -> any {
            let raw = self.store.get(key);
            if (raw != null) { return CacheValue.decode(raw); }
            let v = f();
            self.forever(key, v);
            return v;
        }
        fn increment(key: string, by: long = 1) -> long { return self.store.increment(key, by); }
        fn decrement(key: string, by: long = 1) -> long { return self.store.increment(key, 0 - by); }
        // Several at once (missing ones left out): one store read for all of
        // them where the store can (Redis: one MGET), else one per key.
        fn many(keys: Array<string>) -> HashMap<string, any> {
            let raw = self.store.getMany(keys);
            let out = new HashMap<string, any>();
            for (i, k in keys) {
                let r = raw[i];
                if (r != null) { out.put(k, CacheValue.decode(r)); }
            }
            return out;
        }
        // (Redis: every SET in one pipelined round trip.)
        fn putMany(values: HashMap<string, any>, ttlSeconds: long = 0) {
            let encoded = new HashMap<string, string>();
            values.forEach(fn(k: string, v: any) { encoded.put(k, CacheValue.encode(v)); });
            self.store.putMany(encoded, ttlSeconds);
        }
        fn flush() { self.store.flush(); }
        // Stores it only when the key is missing; whether it did.
        fn add(key: string, value: any, ttlSeconds: long = 0) -> bool { return self.store.add(key, CacheValue.encode(value), ttlSeconds); }
        // A lock called `name`, held for at most `seconds` (0: until released),
        // owned by `owner` (a random token by default). Take it with get() or block().
        fn lock(name: string, seconds: long = 0, owner: string = "") -> CacheLock { return new CacheLock(self.store, name, seconds, owner); }
        // The lock called `name` as held by `owner` (to release it from another
        // process or job that was handed the owner token).
        fn restoreLock(name: string, owner: string) -> CacheLock { return new CacheLock(self.store, name, 0, owner); }
        // A rate limiter whose counters live in this store.
        fn limiter() -> RateLimiter { return new RateLimiter(self.store); }
    }

    // A lock several processes (or threads) share through a cache store, as
    // Laravel's Cache::lock(): only one owner holds it at a time, it lapses
    // after its lifetime (so a crashed holder cannot keep it), and only its
    // owner releases it.
    //
    //   let lock = Cache.lock("reports:daily", 120)
    //   if (lock.get()) { try { build() } finally { lock.release() } }
    //   lock.block(5, fn() { build() })        // waits up to 5 seconds for it
    class CacheLock {
        public name: string
        public seconds: long
        private store: CacheStore
        private ownerToken: string
        // How long block() waits between tries, in milliseconds.
        public retryMs: int = 100

        constructor(store: CacheStore, name: string, seconds: long, owner: string = "") {
            self.store = store;
            self.name = name;
            self.seconds = seconds;
            self.ownerToken = owner == "" ? Hash.randomToken(16) : owner;
        }
        private fn key() -> string { return "lock:" + self.name; }
        // Takes it if it is free; whether this owner now holds it.
        fn get() -> bool { return self.store.add(self.key(), self.ownerToken, self.seconds); }
        // Takes it and runs `f` while holding it (released afterwards, also when
        // f throws); whether it ran.
        fn run(f: fn()) -> bool {
            if (!self.get()) { return false; }
            try { f(); } finally { self.release(); }
            return true;
        }
        // Waits up to `waitSeconds` for it; LockTimeoutException when it stays taken.
        fn block(waitSeconds: long) {
            let deadline = Time.nowMs() + waitSeconds * 1000;
            while (!self.get()) {
                if (Time.nowMs() >= deadline) { throw new LockTimeoutException(self.name); }
                Time.sleepMs(self.retryMs as long);
            }
        }
        // block(), then `f` while holding it.
        fn blockRun(waitSeconds: long, f: fn()) {
            self.block(waitSeconds);
            try { f(); } finally { self.release(); }
        }
        // Lets go, if this owner holds it; whether it did.
        fn release() -> bool { return self.store.forgetIfValue(self.key(), self.ownerToken); }
        // Lets go whoever holds it.
        fn forceRelease() { self.store.forget(self.key()); }
        fn owner() -> string { return self.ownerToken; }
        // Whether it is held at all (by anyone).
        fn isLocked() -> bool { return self.store.has(self.key()); }
        // Whether this owner is the one holding it.
        fn isOwnedByCurrentProcess() -> bool { let v = self.store.get(self.key()); return v != null && v == self.ownerToken; }
    }

    // block() gave up waiting.
    class LockTimeoutException extends Exception {
        constructor(name: string) { super("timed out waiting for the lock '" + name + "'"); }
        public fn kind() -> string { return "LockTimeoutException"; }
    }

    // Counting attempts in a window, as Laravel's RateLimiter: login tries,
    // API calls, jobs that call a rate-limited service.
    //
    //   let limiter = Cache.limiter()
    //   if (limiter.tooManyAttempts("login:" + ip, 5)) { … wait limiter.availableIn("login:" + ip) seconds }
    //   limiter.hit("login:" + ip, 60)
    //   limiter.attempt("send:" + userId, 3, fn() { send() }, 60)
    class RateLimiter {
        private store: CacheStore
        constructor(store: CacheStore) { self.store = store; }
        private static fn clean(key: string) -> string { return "limiter:" + key; }

        // Counts an attempt in a window of `decaySeconds` (the window starts at
        // the first attempt); the count so far.
        fn hit(key: string, decaySeconds: long = 60) -> long { return self.increment(key, decaySeconds, 1); }
        fn increment(key: string, decaySeconds: long = 60, amount: long = 1) -> long {
            let k = RateLimiter.clean(key);
            // (the timer marks when the window ends; the counter starts at 0 with the same lifetime)
            self.store.add(k + ":timer", "${Time.now() + decaySeconds}", decaySeconds);
            self.store.add(k, "0", decaySeconds);
            return self.store.increment(k, amount);              // (every store's increment keeps the expiry)
        }
        fn decrement(key: string, decaySeconds: long = 60, amount: long = 1) -> long { return self.increment(key, decaySeconds, -amount); }
        fn attempts(key: string) -> long {
            let v = self.store.get(RateLimiter.clean(key));
            return v == null ? 0 : Integer.parseOr(v, 0);
        }
        fn tooManyAttempts(key: string, maxAttempts: long) -> bool {
            if (self.attempts(key) < maxAttempts) { return false; }
            return self.store.has(RateLimiter.clean(key) + ":timer");
        }
        fn remaining(key: string, maxAttempts: long) -> long { let r = maxAttempts - self.attempts(key); return r < 0 ? 0 : r; }
        fn retriesLeft(key: string, maxAttempts: long) -> long { return self.remaining(key, maxAttempts); }
        // Seconds until the window ends (0 when there is none).
        fn availableIn(key: string) -> long {
            let v = self.store.get(RateLimiter.clean(key) + ":timer");
            if (v == null) { return 0; }
            let left = Integer.parseOr(v, 0) - Time.now();
            return left < 0 ? 0 : left;
        }
        // Runs `f` and counts it, unless the limit is reached; whether it ran.
        fn attempt(key: string, maxAttempts: long, f: fn(), decaySeconds: long = 60) -> bool {
            if (self.tooManyAttempts(key, maxAttempts)) { return false; }
            f();
            self.hit(key, decaySeconds);
            return true;
        }
        fn resetAttempts(key: string) -> bool { return self.store.forget(RateLimiter.clean(key)); }
        fn clear(key: string) {
            self.store.forget(RateLimiter.clean(key));
            self.store.forget(RateLimiter.clean(key) + ":timer");
        }
    }

    // The stores a program uses, by name (see the top of this file).
    class Cache {
        private static named: HashMap<string, CacheRepository> = new HashMap<string, CacheRepository>()

        // Makes `store` the one called `name` ("default" otherwise).
        static fn store(store: CacheStore, name: string = "default") { Cache.named.put(name, new CacheRepository(store)); }
        static fn repository(name: string = "default") -> CacheRepository {
            let key = name == "" ? "default" : name;
            let r = Cache.named.getOr(key, null);
            if (r == null) {
                throw new StateError(key == "default" ? "no cache store: call Cache.store(aStore) first"
                    : "no cache store called '" + key + "': Cache.store(aStore, \"" + key + "\")");
            }
            return r;
        }
        static fn hasStore(name: string = "default") -> bool { return Cache.named.containsKey(name == "" ? "default" : name); }

        // ── the default store, forwarded ─────────────────────────────────────────
        static fn get(key: string, fallback: any = null) -> any { return Cache.repository().get(key, fallback); }
        static fn put(key: string, value: any, ttlSeconds: long = 0) { Cache.repository().put(key, value, ttlSeconds); }
        static fn forever(key: string, value: any) { Cache.repository().forever(key, value); }
        static fn has(key: string) -> bool { return Cache.repository().has(key); }
        static fn forget(key: string) -> bool { return Cache.repository().forget(key); }
        static fn pull(key: string, fallback: any = null) -> any { return Cache.repository().pull(key, fallback); }
        static fn remember(key: string, ttlSeconds: long, f: fn() -> any) -> any { return Cache.repository().remember(key, ttlSeconds, f); }
        static fn rememberForever(key: string, f: fn() -> any) -> any { return Cache.repository().rememberForever(key, f); }
        static fn increment(key: string, by: long = 1) -> long { return Cache.repository().increment(key, by); }
        static fn decrement(key: string, by: long = 1) -> long { return Cache.repository().decrement(key, by); }
        static fn many(keys: Array<string>) -> HashMap<string, any> { return Cache.repository().many(keys); }
        static fn putMany(values: HashMap<string, any>, ttlSeconds: long = 0) { Cache.repository().putMany(values, ttlSeconds); }
        static fn flush() { Cache.repository().flush(); }
        static fn add(key: string, value: any, ttlSeconds: long = 0) -> bool { return Cache.repository().add(key, value, ttlSeconds); }
        static fn lock(name: string, seconds: long = 0, owner: string = "") -> CacheLock { return Cache.repository().lock(name, seconds, owner); }
        static fn restoreLock(name: string, owner: string) -> CacheLock { return Cache.repository().restoreLock(name, owner); }
        static fn limiter() -> RateLimiter { return Cache.repository().limiter(); }
    }
}
